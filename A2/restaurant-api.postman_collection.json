    {
      "name": "Auth - Get Current User Profile (200 OK)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customer_token}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auth/me",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "auth", "me"]
        }
      }
