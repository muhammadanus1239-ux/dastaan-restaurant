{
  "info": {
    "_postman_id": "a6f2c330-dastaan-api-collection",
    "name": "DASTAAN Restaurant API",
    "description": "Postman Collection for DASTAAN Restaurant App (Assignment 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "menu_item_id",
      "value": "651234567890abcdef123456",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "your_customer_jwt_token_here",
      "type": "string"
    },
    {
      "key": "manager_token",
      "value": "your_manager_jwt_token_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/api/health",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Auth - Register Customer (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Customer\",\n  \"email\": \"newcustomer@dastaan.com\",\n  \"password\": \"Customer123\",\n  \"role\": \"customer\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/auth/register",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
