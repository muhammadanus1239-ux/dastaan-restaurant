    {
      "name": "A2 Q7 Test 1: Place Order (201 Created - Server Calculates Total)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customer_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderType\": \"Dine-in\",\n  \"table\": \"Table 3\",\n  \"promoCode\": \"WELCOME10\",\n  \"items\": [\n    {\n      \"name\": \"Special Chicken Dum Biryani\",\n      \"price\": 1350,\n      \"quantity\": 2,\n      \"note\": \"Extra saffron raita\"\n    },\n    {\n      \"name\": \"Royal Mint Lemonade\",\n      \"price\": 350,\n      \"quantity\": 2\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/orders",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "orders"]
        }
      }
    },
    {
      "name": "A2 Q7 Test 2: Manager Advance Status to Preparing (200 OK)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{manager_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Preparing\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/orders/{{order_id}}/status",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "orders", "{{order_id}}", "status"]
        }
      }
    },
    {
      "name": "A2 Q7 Test 3: Customer Cancel Preparing Order (400 Bad Request - Must Fail)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{customer_token}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/orders/{{order_id}}/cancel",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "orders", "{{order_id}}", "cancel"]
        }
      }
    },
